{
  "name": "@poster/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx src/worker.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "10.0.0",
    "@poster/contracts": "workspace:*",
    "@poster/core": "workspace:*",
    "fastify": "^5.2.1",
    "file-type": "^22.3.0",
    "playwright": "1.65.0",
    "sharp": "^0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2"
  }
}
