{
  "name": "@poster/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-font-licenses.mjs",
    "dev": "pnpm --filter @poster/core build && vite",
    "prebuild": "node scripts/copy-font-licenses.mjs",
    "build": "pnpm --filter @poster/core build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.0.0",
    "@fontsource/bebas-neue": "^5.0.0",
    "@fontsource/cairo": "^5.0.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/lobster": "^5.0.0",
    "@fontsource/montserrat": "^5.0.0",
    "@fontsource/noto-kufi-arabic": "^5.0.0",
    "@fontsource/playfair-display": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "@fontsource/tajawal": "^5.0.0",
    "@poster/contracts": "workspace:*",
    "@poster/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
