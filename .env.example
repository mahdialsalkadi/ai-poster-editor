# Runtime
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173

# Assets and export limits (the v1 server is stateless: there is no database)
MAX_UPLOAD_BYTES=10485760

# AI provider (milestone 5). No provider is wired yet: /api/ai/generate and
# /api/ai/edit answer UNSUPPORTED_FEATURE until milestone 5 implements one.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=60000
AI_DAILY_BUDGET_USD=5

# Export worker (milestone 6)
EXPORT_CONCURRENCY=2
EXPORT_TIMEOUT_MS=15000
EXPORT_MAX_OUTPUT_PIXELS=40000000

# Rate limits
RATE_LIMIT_AI_PER_MINUTE=5
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
