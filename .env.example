# Local development only. Public deployment requires the hardening in docs/audit.md.
# Bare dev/start scripts do not load this file; see the README's --env-file command.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173

# There is no database. The server keeps no document snapshots (the web keeps
# them in IndexedDB); the in-memory export cache and the durable daily spend
# ledger are the only server state, and both are documented in docs/audit.md.
#
# Access control. Production refuses to start without either Supabase Auth or an
# API key unless ALLOW_PUBLIC_API=true. The browser signs in through this server;
# the Supabase anon key is safe to use server-side, the service-role key is not used.
API_ACCESS_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# HS256 projects only. Asymmetric (RS256/ES256) projects use the JWKS endpoint.
SUPABASE_JWT_SECRET=
# >= 32 random characters; signs the HttpOnly session cookie.
AUTH_COOKIE_SECRET=
ALLOW_PUBLIC_API=
# Number of trusted proxy hops, `true`, `false`, or a Fastify trust-proxy value.
TRUST_PROXY=

# Leave AI_PROVIDER empty to disable AI. Accepted: openai, openai-compatible.
# Never put the provider key in a Vite variable or the public web bundle.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=60000

# Accounting is per process/UTC day; the spent total is persisted atomically in
# AI_SPEND_LEDGER_PATH so it survives restarts. Use one API replica per ledger file.
# Both prices are REQUIRED when AI_PROVIDER is set; these values are examples, not
# a current price quote for the selected provider.
AI_DISABLED=
AI_DAILY_SPEND_CAP_USD=5
# Optional per-principal daily USD cap; defaults to the deployment-wide cap.
AI_USER_DAILY_SPEND_CAP_USD=
AI_INPUT_USD_PER_MTOK=0.15
AI_OUTPUT_USD_PER_MTOK=0.6
AI_SPEND_LEDGER_PATH=.data/ai-spend.json

# Asset, export and rate limits currently come from packages/core/src/limits.ts.
# The export route uses its limiter; export/upload constants are not environment
# overrides. The standalone upload route remains a stub.
EXPORT_DISABLED=

# Chromium sandbox is on by default. Set false only when the renderer runs in a
# disposable container without network egress and the platform cannot enable the
# sandbox (Docker needs user namespaces, an appropriate seccomp profile, or
# CAP_SYS_ADMIN). Never disable it for a long-lived worker with network access.
EXPORT_CHROMIUM_SANDBOX=true

# Internal renderer worker service (Docker deployment uses this path). When
# EXPORT_WORKER_URL is set the API renders through this service instead of the
# local child process; the bearer token adds internal-only authentication.
WORKER_HOST=127.0.0.1
WORKER_PORT=3002
EXPORT_WORKER_URL=
EXPORT_WORKER_TOKEN=
