# Local development only. Public deployment requires the hardening in docs/audit.md.
# Bare dev/start scripts do not load this file; see the README's --env-file command.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173

# There is no database, but the server is NOT stateless: snapshots, export results
# and the daily spend ledger are in memory and are lost on restart.
#
# Access control. Production refuses to start without either Supabase Auth or an
# API key unless ALLOW_PUBLIC_API=true. The browser signs in through this server;
# the Supabase anon key is safe to use server-side, the service-role key is not used.
API_ACCESS_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# HS256 projects only. Asymmetric (RS256/ES256) projects use the JWKS endpoint.
SUPABASE_JWT_SECRET=
# >= 32 random characters; signs the HttpOnly session cookie.
AUTH_COOKIE_SECRET=
ALLOW_PUBLIC_API=
# Number of trusted proxy hops, `true`, `false`, or a Fastify trust-proxy value.
TRUST_PROXY=

# Leave AI_PROVIDER empty to disable AI. Accepted: openai, openai-compatible.
# Never put the provider key in a Vite variable or the public web bundle.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=60000

# Accounting is per process/UTC day and is not yet a reliable public spend ceiling.
# A retry can exceed the single-attempt reservation. Set BOTH prices for your model;
# these values are defaults, not a current price quote for the selected provider.
AI_DAILY_SPEND_CAP_USD=5
AI_INPUT_USD_PER_MTOK=0.15
AI_OUTPUT_USD_PER_MTOK=0.6

# Asset, export and rate limits currently come from packages/core/src/limits.ts.
# MAX_UPLOAD_BYTES, EXPORT_* and RATE_LIMIT_* overrides are not read by this build.
# Export/upload rate constants are not wired to route limiters yet.
