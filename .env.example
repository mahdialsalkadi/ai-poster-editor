# Runtime
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173

# Assets and export limits (the v1 server is stateless: there is no database)
MAX_UPLOAD_BYTES=10485760

# AI provider. Leave AI_PROVIDER empty to keep /api/ai/* answering
# UNSUPPORTED_FEATURE. Supported values: openai, openai-compatible.
# The key stays on the server and is never sent to the browser.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=16000
AI_TIMEOUT_MS=60000
# Spend is reserved before each call and settled after it, per UTC day.
AI_DAILY_SPEND_CAP_USD=5
AI_INPUT_USD_PER_MTOK=0.15
AI_OUTPUT_USD_PER_MTOK=0.6

# Export worker (milestone 6)
EXPORT_CONCURRENCY=2
EXPORT_TIMEOUT_MS=15000
EXPORT_MAX_OUTPUT_PIXELS=40000000

# Rate limits
RATE_LIMIT_AI_PER_MINUTE=5
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
