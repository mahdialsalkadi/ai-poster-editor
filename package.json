{
  "name": "ai-poster-editor",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI-assisted poster editor built around a strict Design HTML contract",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @poster/core test",
    "test:coverage": "vitest run --coverage --exclude packages/core/test/perf.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:serve": "tsx e2e/server.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "update-goldens": "playwright test e2e/visual.spec.ts --update-snapshots",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "audit:prod": "pnpm audit --prod",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.14.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
